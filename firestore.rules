rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Root shops collection: Document ID = phone number (e.g. shops/0661234567)
    match /shops/{phoneNumber} {
      allow read, write: if true;

      // Sub-collections for products, sales, customers, repairs, settings, etc.
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
