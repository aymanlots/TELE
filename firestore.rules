rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default shop collections permission:
    // Allow read & write to enable instant synchronization across all store devices (Phone, PC, Tablet)
    match /shops/{shopId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /sales/{saleId} {
      allow read, write: if true;
    }

    match /repairs/{repairId} {
      allow read, write: if true;
    }

    match /spare_parts/{partId} {
      allow read, write: if true;
    }

    match /warranties/{warrantyId} {
      allow read, write: if true;
    }

    match /sav_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /recurring_expenses/{recId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    match /supplier_payments/{payId} {
      allow read, write: if true;
    }

    match /supplier_purchase_orders/{poId} {
      allow read, write: if true;
    }

    match /customer_payments/{payId} {
      allow read, write: if true;
    }

    match /stock_movements/{movId} {
      allow read, write: if true;
    }

    match /cash_closures/{closureId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
